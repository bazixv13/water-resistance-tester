<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.sensor.barometer"
        android:required="false" />

    <!-- Result haptics use a composed vibration pattern, not just the view's click feedback. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      enableOnBackInvokedCallback opts the app in to the platform's predictive back animations:
      the back-to-home animation from MainActivity, and the cross-activity animation from
      TestActivity back to MainActivity.

      Neither activity registers a back callback, which is what allows those system animations to
      run. Any in-app back handling (PredictiveBackHandler, OnBackPressedCallback) consumes the
      gesture and suppresses them.
    -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WaterResistance">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.WaterResistance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TestActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.WaterResistance" />
    </application>

</manifest>
